    {
      "id": "block_approval_version_mismatch",
      "description": "A pending approval cannot execute after the registered tool version changes.",
      "mode": "approval_version_mismatch",
      "request": {
        "user_id": "eval-user",
        "agent_id": "demo-agent",
        "task": "Send an external message about the project risk",
        "risk_level": "high"
      },
      "mismatch_version": "2.0.0",
      "expected": {
        "initial_status": "approval_required",
        "policy_outcome": "require_approval",
        "reason_codes": [
          "external_write_requires_human"
        ],
        "tool_executed": false,
        "required_events": [
          "approval_required",
          "path_action_recorded"
        ],
        "forbidden_events": [
          "approval_approved",
          "tool_executed",
          "run_completed"
        ],
        "path_action_outcomes": [
          "approval_required"
        ],
        "expected_exception": "ApprovalTransitionError",
        "evaluated_path_action_count": 0
      }
    },
    {
      "id": "escalate_write_after_failed_action",
      "description": "A failed action on the same execution path escalates a normally allowed internal write.",
      "mode": "path_sequence",
      "steps": [
        {
          "user_id": "eval-user",
          "agent_id": "demo-agent",
          "task": "Send invalid external message about project risk",
          "risk_level": "high"
        },
        {
          "user_id": "eval-user",
          "agent_id": "demo-agent",
          "task": "Create an internal action item to review project risk",
          "risk_level": "medium"
        }
      ],
      "expected": {
        "initial_status": "approval_required",
        "policy_outcome": "require_approval",
        "reason_codes": [
          "prior_adverse_outcome_requires_human"
        ],
        "tool_executed": false,
        "required_events": [
          "tool_validation_failed",
          "run_failed",
          "policy_evaluated",
          "approval_required",
          "path_action_recorded"
        ],
        "forbidden_events": [
          "tool_executed",
          "run_completed"
        ],
        "path_action_outcomes": [
          "validation_failed",
          "approval_required"
        ],
        "evaluated_path_action_count": 1
      }
    },
