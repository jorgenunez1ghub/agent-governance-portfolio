      "mode": "runtime",
      "request": {
        "user_id": "eval-user",
        "agent_id": "read-only-agent",
        "task": "Create an internal action item to review project risk",
        "risk_level": "medium"
      },
      "expected": {
        "initial_status": "denied",
        "policy_outcome": "deny",
        "reason_codes": [
          "tool_outside_agent_scope"
        ],
        "tool_executed": false,
        "required_events": [
          "policy_evaluated",
          "run_denied",
          "path_action_recorded"
        ],
        "forbidden_events": [
          "tool_executed",
          "run_completed"
        ],
        "path_action_outcomes": [
          "denied"
        ],
        "evaluated_path_action_count": 0
      }
    },
    {
      "id": "deny_unknown_agent",
