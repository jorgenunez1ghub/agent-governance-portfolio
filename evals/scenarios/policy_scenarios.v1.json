{
  "schema_version": "1.2.0",
  "suite_id": "agent-governance-policy-core",
  "policy_version": "agent-governance-policy-2.1",
  "scenarios": [
    {
      "id": "allow_trusted_internal_write",
      "description": "A trusted, in-scope internal write executes automatically on a clean path.",
      "mode": "runtime",
      "request": {
        "user_id": "eval-user",
        "agent_id": "demo-agent",
        "task": "Create an internal action item to review project risk",
        "risk_level": "medium"
      },
      "expected": {
        "initial_status": "completed",
        "policy_outcome": "allow",
        "reason_codes": [
          "trusted_tool_within_agent_scope"
        ],
        "tool_executed": true,
        "required_events": [
          "run_started",
          "tool_validation_passed",
          "policy_evaluated",
          "tool_executed",
          "run_completed",
          "path_action_recorded"
        ],
        "forbidden_events": [
          "approval_required",
          "run_denied",
          "run_failed"
        ],
        "path_action_outcomes": [
          "executed"
        ],
        "evaluated_path_action_count": 0
      }
    },
    {
      "id": "approve_external_write",
      "description": "An external write pauses and executes only after approval.",
      "mode": "runtime",
      "request": {
        "user_id": "eval-user",
        "agent_id": "demo-agent",
        "task": "Send an external message about the project risk",
        "risk_level": "high"
      },
      "tool_behavior": {
        "tool_name": "send_external_message",
        "mode": "count_only"
      },
      "approval_attempts": [
        {
          "idempotency_key": "approve-external-write"
        }
      ],
      "expected": {
        "initial_status": "approval_required",
        "final_status": "executed",
        "policy_outcome": "require_approval",
        "reason_codes": [
          "external_write_requires_human"
        ],
        "tool_executed": true,
        "required_events": [
          "approval_required",
          "approval_approved",
          "approval_execution_started",
          "execution_receipt_recorded",
          "tool_executed",
          "run_completed",
          "path_action_recorded",
          "path_action_updated"
        ],
        "forbidden_events": [
          "run_denied"
        ],
        "path_action_outcomes": [
          "executed"
        ],
        "evaluated_path_action_count": 0,
        "approval_attempt_results": [
          "executed"
        ],
        "execution_receipt_statuses": [
          "succeeded"
        ],
        "approval_state": "executed",
        "handler_call_count": 1,
        "idempotent_replay_count": 0
      }
    },
    {
      "id": "deny_out_of_scope_tool",
