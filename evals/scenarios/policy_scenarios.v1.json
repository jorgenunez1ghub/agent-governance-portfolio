        "forbidden_events": [
          "tool_executed",
          "run_completed"
        ],
        "path_action_outcomes": [
          "denied"
        ],
        "evaluated_path_action_count": 0
      }
    },
    {
      "id": "deny_untrusted_tool",
      "description": "A registry tool marked unverified is denied with provenance evidence.",
